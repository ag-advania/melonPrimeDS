{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "description": "Base configuration",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MELONPRIME_ENABLE_DEVELOPER_FEATURES": {
          "type": "BOOL",
          "value": "OFF"
        },
        "MELONPRIME_ENABLE_RENDERER_PERF_TELEMETRY": {
          "type": "BOOL",
          "value": "OFF"
        },
        "MELONPRIME_ENABLE_GPU_MEMORY_TELEMETRY": {
          "type": "BOOL",
          "value": "OFF"
        },
        "MELONPRIME_ENABLE_VULKAN_LATENCY_CAPTURE": {
          "type": "BOOL",
          "value": "OFF"
        }
      }
    },
    {
      "name": "base-vcpkg",
      "inherits": "base",
      "description": "Base configuration with vcpkg",
      "cacheVariables": {
        "USE_VCPKG": {
          "type": "BOOL",
          "value": "ON"
        },
        "BUILD_STATIC": {
          "type": "BOOL",
          "value": "ON"
        }
      },
      "hidden": true
    },
    {
      "name": "release",
      "inherits": "base",
      "description": "Generic release build",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "release-mingw-x86_64",
      "inherits": "base-vcpkg",
      "displayName": "Windows MinGW Release (x64)",
      "condition": {
        "type": "notEquals",
        "lhs": "$env{MINGW_PREFIX}",
        "rhs": ""
      }
    },
    {
      "name": "release-mingw-shipping-x86_64",
      "inherits": "release-mingw-x86_64",
      "displayName": "Windows MinGW Shipping Release (x64)",
      "description": "Shipping MinGW Release build with developer features, renderer performance telemetry, and Vulkan latency capture compiled out. Uses a separate build tree so Qt AUTOGENERATED files cannot leak from the developer Release profile.",
      "binaryDir": "${sourceDir}/build/release-mingw-shipping-x86_64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS_RELEASE": "-O3 -DNDEBUG",
        "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG",
        "CMAKE_EXE_LINKER_FLAGS_RELEASE": "",
        "ENABLE_LTO_RELEASE": {
          "type": "BOOL",
          "value": "OFF"
        },
        "MELONPRIME_ENABLE_DEVELOPER_FEATURES": {
          "type": "BOOL",
          "value": "OFF"
        },
        "MELONPRIME_ENABLE_RENDERER_PERF_TELEMETRY": {
          "type": "BOOL",
          "value": "OFF"
        },
        "MELONPRIME_ENABLE_GPU_MEMORY_TELEMETRY": {
          "type": "BOOL",
          "value": "OFF"
        },
        "MELONPRIME_ENABLE_VULKAN_LATENCY_CAPTURE": {
          "type": "BOOL",
          "value": "OFF"
        },
        "MELONPRIME_ENABLE_VULKAN": {
          "type": "BOOL",
          "value": "ON"
        },
        "MELONPRIME_FORCE_DISABLE_VULKAN": {
          "type": "BOOL",
          "value": "OFF"
        },
        "MELONPRIME_ENABLE_DX12": {
          "type": "BOOL",
          "value": "ON"
        },
        "MELONPRIME_FORCE_DISABLE_DX12": {
          "type": "BOOL",
          "value": "OFF"
        }
      }
    },
    {
      "name": "debug-mingw-x86_64",
      "inherits": "release-mingw-x86_64",
      "displayName": "Windows MinGW Debug (x64)",
      "description": "Debug MinGW build. CMAKE_BUILD_TYPE=Debug is what defines MELONDS_VULKAN_ENABLE_VALIDATION, so this is the preset the Vulkan Validation Layer workflow uses. Never measure latency with it. Requires release-mingw-x86_64 to have been built first: its vcpkg tree is reused rather than rebuilt, because the MinGW triplet is release-only and a second dependency set would take hours to produce identical libraries.",
      "binaryDir": "${sourceDir}/build/debug-mingw-x86_64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/release-mingw-x86_64/vcpkg_installed",
        "VCPKG_MANIFEST_INSTALL": {
          "type": "BOOL",
          "value": "OFF"
        },
        "ENABLE_DEBUG_DEPS": {
          "type": "BOOL",
          "value": "OFF"
        }
      }
    },
    {
      "name": "base-windows",
      "inherits": "base-vcpkg",
      "description": "Base settings for Windows VS builds",
      "hidden": true,
      "displayName": "Windows base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang.exe",
        "CMAKE_CXX_COMPILER": "clang++.exe",
        "CMAKE_RC_COMPILER": "llvm-rc.exe"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [ "Windows" ]
        }
      }
    },
    {
      "name": "release-windows-x86_64",
      "inherits": "base-windows",
      "displayName": "Windows Release (x64)",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      }
    },
    {
      "name": "debug-windows-x86_64",
      "inherits": "release-windows-x86_64",
      "displayName": "Windows Debug (x64)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release-windows-arm64",
      "inherits": "base-windows",
      "displayName": "Windows Release (ARM64)",
      "architecture": {
        "value": "arm64",
        "strategy": "external"
      }
    },
    {
      "name": "debug-windows-arm64",
      "inherits": "release-windows-arm64",
      "displayName": "Windows Debug (ARM64)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release-mac-x86_64",
      "inherits": "base-vcpkg",
      "displayName": "macOS release (x86_64)",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "release-mac-arm64",
      "inherits": "base-vcpkg",
      "displayName": "macOS release (arm64)",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "displayName": "Release"
    },
    {
      "name": "release-mingw-x86_64",
      "configurePreset": "release-mingw-x86_64",
      "displayName": "MinGW Release (x86_64)"
    },
    {
      "name": "release-mingw-shipping-x86_64",
      "configurePreset": "release-mingw-shipping-x86_64",
      "displayName": "MinGW Shipping Release (x86_64)"
    },
    {
      "name": "debug-mingw-x86_64",
      "configurePreset": "debug-mingw-x86_64",
      "displayName": "MinGW Debug (x86_64)"
    },
    {
      "name": "release-windows-x86_64",
      "configurePreset": "release-windows-x86_64",
      "displayName": "Windows Release (x64)"
    },
    {
      "name": "debug-windows-x86_64",
      "configurePreset": "debug-windows-x86_64",
      "displayName": "Windows Debug (x64)"
    },
    {
      "name": "release-windows-arm64",
      "configurePreset": "release-windows-arm64",
      "displayName": "Windows Release (ARM64)"
    },
    {
      "name": "debug-windows-arm64",
      "configurePreset": "debug-windows-arm64",
      "displayName": "Windows Debug (ARM64)"
    },
    {
      "name": "release-mac-x86_64",
      "configurePreset": "release-mac-x86_64",
      "displayName": "macOS Release (x86_64)"
    },
    {
      "name": "release-mac-arm64",
      "configurePreset": "release-mac-arm64",
      "displayName": "macOS Release (arm64)"
    }
  ]
}
