#version 450

// Structured 2D / Vulkan 3D compositor.
//
// This is a semantic transliteration of DX12Shaders::Compositor
// (src/GPU3D_DX12_shaders.h). Both backends consume the identical structured
// contract published by melonDS::SoftRenderer, so they must produce identical
// pixels for identical input. Every constant here is the named value from
// src/MelonPrimeStructuredComposition.h and is cross-checked by
// tools/ci/audits/audit-structured-composition-contract.py.
//
// The composition is a pure function of ONE emulated frame:
//   * the current frame's three structured planes per screen,
//   * that frame's per-scanline metadata,
//   * the current Vulkan 3D color target,
//   * the current 3D X scroll.
//
// It deliberately has no previous-frame images, no captured-3D side channel,
// no screen-swap input and no scene statistics. The producer already resolved
// screen ownership (SoftRenderer::DrawScanline assigns engines to LCDs through
// GPU.ScreenSwap before publishing), and the per-pixel control word already
// states whether a 3D slot exists. Re-deciding either of those from frame
// history or from pixel counts is what made the previous compositor alternate
// between two different pictures on games like Metroid Prime Hunters, which
// flips POWCNT1 bit 15 every frame.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) uniform writeonly image2D outImage;
layout(set = 0, binding = 1, rgba8) uniform readonly image2D image3dInput;

layout(set = 0, binding = 2, std430) readonly buffer TopPackedBuffer
{
    uint topPacked[];
};

layout(set = 0, binding = 3, std430) readonly buffer BottomPackedBuffer
{
    uint bottomPacked[];
};

layout(push_constant) uniform PushConsts
{
    uint outputWidth;
    uint outputHeight;
    uint scale;
    uint rendererWidth;
    uint rendererHeight;
    uint packedStride;
    // 0 while the 3D frame was aborted, which is the DX12 TexWidth gate.
    uint has3D;
} pc;

// --- Structured contract (src/MelonPrimeStructuredComposition.h) -------------
const uint kControlFlagShift = 24u;
const uint kControlEvbShift = 16u;
const uint kControlEvaShift = 8u;
const uint kControlBlendFactorMask = 0x1Fu;
const uint kControlCompositionModeMask = 0x0Fu;
const uint kControlHas3DSlot = 0x40u;
const uint kControlAbovePlane = 0x80u;

const uint kCompositionModeBlend4 = 1u;
const uint kCompositionModeBrightnessUp = 2u;
const uint kCompositionModeBrightnessDown = 3u;
const uint kCompositionModeBlend5 = 4u;

const uint kLineMetaBrightnessFactorMask = 0x1Fu;
const uint kLineMetaBrightnessModeShift = 8u;
const uint kLineMetaBrightnessModeMask = 0x3u;
const uint kLineMetaDisplayModeShift = 16u;
const uint kLineMetaDisplayModeMask = 0x3u;
const uint kLineMetaRenderXPosShift = 23u;
const uint kLineMetaRenderXPosMask = 0x1FFu;

const uint kBrightnessModeUp = 1u;
const uint kBrightnessModeDown = 2u;
const uint kBrightnessFactorLimit = 16u;

const uint kDisplayModeOff = 0u;

const uint k3DPlaceholderPixel = 0x20000000u;
const uint k3DLayerSlotPixel = 0x40000000u;
// --- end structured contract ------------------------------------------------

// Packed buffer layout, one screen per buffer:
//   [line * stride + 0   .. + 255]  plane 0 (below)
//   [line * stride + 256 .. + 511]  plane 1 (above)
//   [line * stride + 512 .. + 767]  plane 2 (control)
//   [line * stride + 768]           line metadata
const int kPlaneAboveOffset = 256;
const int kPlaneControlOffset = 512;
const int kLineMetaOffset = 768;

const int kDsWidth = 256;
const int kDsHeight = 192;
// Two blank scanlines separate the screens in the composition image so the
// presenter can sample either screen without bleeding across the seam.
const int kScreenGapLines = 2;

uint Color6R(uint color) { return color & 0x3Fu; }
uint Color6G(uint color) { return (color >> 8u) & 0x3Fu; }
uint Color6B(uint color) { return (color >> 16u) & 0x3Fu; }

uint PackColor6(uint r, uint g, uint b, uint alpha)
{
    return min(r, 63u) | (min(g, 63u) << 8u) | (min(b, 63u) << 16u) | (alpha << 24u);
}

// melonDS::ColorBlend4 (src/GPU_ColorOp.h).
uint Blend4(uint first, uint second, uint eva, uint evb)
{
    return PackColor6(
        ((Color6R(first) * eva) + (Color6R(second) * evb) + 8u) >> 4u,
        ((Color6G(first) * eva) + (Color6G(second) * evb) + 8u) >> 4u,
        ((Color6B(first) * eva) + (Color6B(second) * evb) + 8u) >> 4u,
        0xFFu);
}

// melonDS::ColorBlend5. The blend weight is the 3D pixel's own 5-bit alpha.
uint Blend5(uint first, uint second)
{
    uint eva = ((first >> 24u) & 0x1Fu) + 1u;
    uint evb = 32u - eva;
    return PackColor6(
        ((Color6R(first) * eva) + (Color6R(second) * evb) + 16u) >> 5u,
        ((Color6G(first) * eva) + (Color6G(second) * evb) + 16u) >> 5u,
        ((Color6B(first) * eva) + (Color6B(second) * evb) + 16u) >> 5u,
        0xFFu);
}

// melonDS::ColorBrightnessUp.
uint BrightnessUp(uint color, uint factor, uint bias)
{
    return PackColor6(
        Color6R(color) + ((((63u - Color6R(color)) * factor) + bias) >> 4u),
        Color6G(color) + ((((63u - Color6G(color)) * factor) + bias) >> 4u),
        Color6B(color) + ((((63u - Color6B(color)) * factor) + bias) >> 4u),
        0xFFu);
}

// melonDS::ColorBrightnessDown.
uint BrightnessDown(uint color, uint factor, uint bias)
{
    return PackColor6(
        Color6R(color) - (((Color6R(color) * factor) + bias) >> 4u),
        Color6G(color) - (((Color6G(color) * factor) + bias) >> 4u),
        Color6B(color) - (((Color6B(color) * factor) + bias) >> 4u),
        0xFFu);
}

uint ReadPacked(bool topScreen, int line, int index)
{
    uint offset = uint(line) * pc.packedStride + uint(index);
    return topScreen ? topPacked[offset] : bottomPacked[offset];
}

// The Vulkan 3D color target is an 8-bit-per-channel image, while the
// structured contract and the software renderer both work in the DS's 6-bit
// color with 5-bit alpha. Convert on read so every arithmetic step below stays
// integer and matches DX12, whose 3D target already uses the packed encoding.
uint Sample3D(int scaledX, int scaledY)
{
    if (pc.has3D == 0u
        || scaledX < 0
        || scaledX >= int(pc.rendererWidth)
        || scaledY < 0
        || scaledY >= int(pc.rendererHeight))
        return 0u;

    vec4 texel = imageLoad(image3dInput, ivec2(scaledX, scaledY));
    uint r = uint(clamp(texel.r * 255.0 + 0.5, 0.0, 255.0)) >> 2u;
    uint g = uint(clamp(texel.g * 255.0 + 0.5, 0.0, 255.0)) >> 2u;
    uint b = uint(clamp(texel.b * 255.0 + 0.5, 0.0, 255.0)) >> 2u;
    uint a = uint(clamp(texel.a * 255.0 + 0.5, 0.0, 255.0)) >> 3u;
    return r | (g << 8u) | (b << 16u) | (a << 24u);
}

// Composition is always nearest. The DS composition rules are defined on whole
// pixels, and the user's Screen.Filter is a presentation preference that the
// software and OpenGL paths apply to the finished screen -- so the presenter
// applies it, once, after this pass. Filtering the 2D planes here as well
// would blur "the 2D under the 3D" into "the final 2D" across every 3D
// silhouette and then blur the result a second time.
uint ReadPlane(bool topScreen, int planeOffset, int sourceX, int dsY)
{
    return ReadPacked(topScreen, dsY, planeOffset + sourceX);
}

uint ComposeScreenPixel(
    bool topScreen,
    int sourceX,
    int dsY,
    int scaledX,
    int scaledY,
    uint safeScale)
{
    uint control = ReadPacked(topScreen, dsY, kPlaneControlOffset + sourceX);
    uint controlFlags = control >> kControlFlagShift;
    uint slotBit = controlFlags & kControlHas3DSlot;

    uint lineMeta = ReadPacked(topScreen, dsY, kLineMetaOffset);

    uint below = ReadPlane(topScreen, 0, sourceX, dsY);
    uint color = below;

    if (slotBit != 0u)
    {
        // Apply the DS 3D X scroll exactly as SoftRenderer3D::GetLine() does,
        // in output space so it stays correct at every internal resolution.
        uint xPosition = (lineMeta >> kLineMetaRenderXPosShift) & kLineMetaRenderXPosMask;
        int source3DX = (xPosition & 0x100u) != 0u
            ? scaledX - int((512u - xPosition) * safeScale)
            : scaledX + int(xPosition * safeScale);
        uint pixel3D = Sample3D(source3DX, scaledY);

        if (((pixel3D >> 24u) & 0x1Fu) != 0u)
        {
            uint above = ReadPlane(topScreen, kPlaneAboveOffset, sourceX, dsY);
            uint compositionMode = controlFlags & kControlCompositionModeMask;
            uint eva = (control >> kControlEvaShift) & kControlBlendFactorMask;
            uint evb = (control >> kControlEvbShift) & kControlBlendFactorMask;
            if (compositionMode == kCompositionModeBlend4
                && (controlFlags & kControlAbovePlane) != 0u)
                color = Blend4(above, pixel3D, eva, evb);
            else if (compositionMode == kCompositionModeBrightnessUp)
                color = BrightnessUp(pixel3D, eva, 8u);
            else if (compositionMode == kCompositionModeBrightnessDown)
                color = BrightnessDown(pixel3D, eva, 7u);
            else if (compositionMode == kCompositionModeBlend5)
                color = Blend5(pixel3D, below);
            else
                color = pixel3D;
        }
    }

    // Master brightness is a scanline register, so it is published per line and
    // applied after composition. A display-mode-0 line was already flattened by
    // the software path and must not be touched again.
    uint displayMode = (lineMeta >> kLineMetaDisplayModeShift) & kLineMetaDisplayModeMask;
    if (displayMode != kDisplayModeOff)
    {
        uint brightnessMode = (lineMeta >> kLineMetaBrightnessModeShift) & kLineMetaBrightnessModeMask;
        uint brightnessFactor = min(lineMeta & kLineMetaBrightnessFactorMask, kBrightnessFactorLimit);
        if (brightnessMode == kBrightnessModeUp)
            color = BrightnessUp(color, brightnessFactor, 0u);
        else if (brightnessMode == kBrightnessModeDown)
            color = BrightnessDown(color, brightnessFactor, 15u);
    }

    return color;
}

uint ToColor8(uint value6)
{
    uint base = min(value6, 63u) << 2u;
    return base | (base >> 6u);
}

void main()
{
    uvec2 gid = gl_GlobalInvocationID.xy;
    if (gid.x >= pc.outputWidth || gid.y >= pc.outputHeight)
        return;

    uint safeScale = max(pc.scale, 1u);
    int sourceY = int(gid.y / safeScale);
    int bottomFirstLine = kDsHeight + kScreenGapLines;
    bool isTopScreen = sourceY < kDsHeight;
    bool isBottomScreen = sourceY >= bottomFirstLine && sourceY < (bottomFirstLine + kDsHeight);
    int sourceX = int(gid.x / safeScale);

    if ((!isTopScreen && !isBottomScreen) || sourceX < 0 || sourceX >= kDsWidth)
    {
        imageStore(outImage, ivec2(gid), vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }

    int dsY = isTopScreen ? sourceY : (sourceY - bottomFirstLine);
    int scaledY = int(gid.y);
    if (isBottomScreen)
        scaledY -= int(uint(bottomFirstLine) * safeScale);

    uint pixel = ComposeScreenPixel(
        isTopScreen, sourceX, dsY, int(gid.x), scaledY, safeScale);

    uint r = ToColor8(Color6R(pixel));
    uint g = ToColor8(Color6G(pixel));
    uint b = ToColor8(Color6B(pixel));

    // The presenter samples this image as BGR stored in the RGBA slots.
    imageStore(
        outImage,
        ivec2(gid),
        vec4(float(b) * (1.0 / 255.0), float(g) * (1.0 / 255.0), float(r) * (1.0 / 255.0), 1.0));
}
