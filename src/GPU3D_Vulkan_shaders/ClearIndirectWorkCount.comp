/*
    1:1 re-expression of ComputeRendererShaders::ClearIndirectWorkCount
    (src/GPU3D_Compute_shaders.h). Nothing but the resource bindings changed.

    Build define: ClearIndirectWorkCount
    Host dispatch (matching GPU3D_Compute.cpp): ((numVariants+31)/32, 1, 1).
    numVariants never exceeds MaxVariants, so the rounded-up tail stays inside
    VariantWorkCount[].
*/

#version 450
#extension GL_GOOGLE_include_directive : require

#include "Common.glsl"
#include "BinningBuffer.glsl"

layout (local_size_x = 32) in;

void main()
{
    VariantWorkCount[gl_GlobalInvocationID.x] = uvec4(1, 1, 0, 0);
}
