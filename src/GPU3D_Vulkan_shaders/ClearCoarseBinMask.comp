/*
    1:1 re-expression of ComputeRendererShaders::ClearCoarseBinMask
    (src/GPU3D_Compute_shaders.h). Nothing but the resource bindings changed.

    Build defines: ClearCoarseBinMask, ClearCoarseBinMaskLocalSize
    ClearCoarseBinMaskLocalSize must be a compile-time literal because it
    selects local_size_x; a specialization constant cannot be used there
    without VK_EXT_subgroup_size_control-style workgroup-size ids, and the GL
    original bakes it as a literal too.

    Host dispatch (matching GPU3D_Compute.cpp):
        (TilesPerLine*TileLines/ClearCoarseBinMaskLocalSize, 1, 1)
*/

#version 450
#extension GL_GOOGLE_include_directive : require

#include "Common.glsl"
#include "BinningBuffer.glsl"

#ifndef ClearCoarseBinMaskLocalSize
#error "ClearCoarseBinMaskLocalSize must be provided by the shader build"
#endif

layout (local_size_x = ClearCoarseBinMaskLocalSize) in;

void main()
{
    BinningMaskAndOffset[BinningCoarseMaskStart + gl_GlobalInvocationID.x*CoarseBinStride+0] = 0;
    BinningMaskAndOffset[BinningCoarseMaskStart + gl_GlobalInvocationID.x*CoarseBinStride+1] = 0;
}
