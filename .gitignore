# Build output directories live at the repository root. Anchored with a leading
# slash so this does not also swallow source directories that happen to be
# named "build" further down, such as tools/build/ and docs/development/build/.
#
# freebios/build/ has its own explicit rule further down.
/build*/
bin
obj
*.depend
*.layout
*.o
melon_grc.c
melon_grc.h
melon.rc
cmake-build*
cmake-build-debug
compile_commands.json
.idea
.cache
artifacts/
/tmp/
/.deps/
/Vulkan-Headers/
__pycache__/
*.py[cod]

*.exe

.DS_Store

# Local ROM/save and PC screenshot evidence must never be committed.
*.sav
*.nds
**/screenshot*.png
**/*-screen*.png
**/Screen Shot*.png
/docs/archive/audits/**/*.png
# Runtime logs can echo local ROM/home paths; keep this machine's raw logs local.
/docs/archive/audits/vulkan/2026-08-14-intel-macbook/**/*.log

.vs
.vscode
CMakeFiles
CMakeCache.txt

freebios/FreeBIOS_Data.h
freebios/bios*
freebios/build/

vcpkg.json.bak
.classpath
.project
.settings/.jsdtscope
.settings/org.eclipse.wst.jsdt.ui.superType.container
.settings/org.eclipse.wst.jsdt.ui.superType.name
.claude/settings.local.json
vcpkg
.claude/worktrees/agent-af2ab1ae
res/assets/weapons/old/Missile.svg
res/assets/weapons/old/Missilev2.svg
res/assets/weapons/old/Missilev3.svg
# MelonPrimeDS local patch/recovery artifacts
.melonprime_linux_input_patch_backup/
.linux_mouse_input_hardening_backup/
.linux_mouse_input_hardening_recovery_snapshot/
.optional_wayland_build_backup/
.wayland_mouse_lock_backup/
.wayland_mouse_lock_recovery_snapshot/
linux_mouse_input_hardening_*.diff
optional_wayland_build_*.diff
wayland_opengl_mouse_lock_*.diff
melonprime_linux_cursor_best_practice_*.diff
