@echo off
setlocal EnableExtensions

rem MinGW shipping/distribution Release build.
rem
rem Unlike build-mingw.bat, this profile explicitly compiles out all
rem developer-only and measurement-only features. The flags are re-applied on
rem every configure so a stale CMake cache cannot silently turn this into a
rem developer or capture build. It uses its own CMake tree so Qt AUTOGENERATED
rem files from the developer profile cannot leak into this build.

set "BASH=C:\msys64\usr\bin\bash.exe"
if not exist "%BASH%" (
    echo [melonprime-release] Missing MSYS2 bash: %BASH%
    echo [melonprime-release] Install MSYS2 at C:\msys64 or update this batch file.
    exit /b 1
)

set "JOBS=1"
set "TAIL_LINES=40"
set "VERBOSE=0"
set "PRESET=release-mingw-shipping-x86_64"
set "BUILD_DIR=build\release-mingw-shipping-x86_64"
set "LOG_FILE=build/release-mingw-shipping-x86_64/last-release-build.log"

:parse_args
if "%~1"=="" goto run_build
if /I "%~1"=="--help" goto help
if /I "%~1"=="-h" goto help
if /I "%~1"=="--verbose" (
    set "VERBOSE=1"
    shift
    goto parse_args
)
if /I "%~1"=="--jobs" (
    if "%~2"=="" goto usage
    set "JOBS=%~2"
    shift
    shift
    goto parse_args
)
if /I "%~1"=="--tail" (
    if "%~2"=="" goto usage
    set "TAIL_LINES=%~2"
    shift
    shift
    goto parse_args
)

echo [melonprime-release] Unknown argument: %~1
goto usage

:help
call :print_usage
exit /b 0

:usage
call :print_usage
exit /b 2

:print_usage
echo Usage: tools\build\windows\build-mingw-release.bat [--verbose] [--jobs N] [--tail N]
echo.
echo Shipping Release profile: CMAKE_BUILD_TYPE=Release, developer features OFF,
echo renderer performance telemetry OFF, and Vulkan latency capture OFF. Vulkan
echo and DX12 remain enabled. The script uses the separate
echo build\release-mingw-shipping-x86_64 tree so developer AUTOGENERATED files
echo cannot leak into the shipping build, while vcpkg may reuse its download cache.
echo MinGW LTO is OFF because the Windows MSYS wrapper cannot link its LTO test
echo targets reliably; normal Release optimization remains enabled.
echo These flags are re-applied during every CMake configure.
echo.
echo Build output is streamed live and the last 40 log lines are printed as a
echo recap. Full output is saved to build\release-mingw-shipping-x86_64\last-release-build.log.
exit /b 0

:run_build
set "SEARCH_DIR=%~dp0"

:find_repo_root
if exist "%SEARCH_DIR%CMakeLists.txt" (
    for %%I in ("%SEARCH_DIR%.") do set "REPO_ROOT_WIN=%%~fI"
    goto repo_root_found
)
for %%I in ("%SEARCH_DIR%..\") do set "PARENT_DIR=%%~fI\"
if /I "%PARENT_DIR%"=="%SEARCH_DIR%" (
    echo [melonprime-release] Could not find CMakeLists.txt above %~dp0
    exit /b 1
)
set "SEARCH_DIR=%PARENT_DIR%"
goto find_repo_root

:repo_root_found
echo [melonprime-release] Repo: %REPO_ROOT_WIN%
echo [melonprime-release] Preset: %PRESET%
echo [melonprime-release] Build dir: %BUILD_DIR%
echo [melonprime-release] Jobs: %JOBS%
echo [melonprime-release] CMAKE_BUILD_TYPE=Release
echo [melonprime-release] MELONPRIME_ENABLE_DEVELOPER_FEATURES=OFF
echo [melonprime-release] MELONPRIME_ENABLE_RENDERER_PERF_TELEMETRY=OFF
echo [melonprime-release] MELONPRIME_ENABLE_VULKAN_LATENCY_CAPTURE=OFF
echo [melonprime-release] MELONPRIME_ENABLE_VULKAN=ON
echo [melonprime-release] MELONPRIME_ENABLE_DX12=ON

rem The preset requires the MinGW environment to be visible before CMake
rem evaluates its condition and before ConfigureVcpkg selects the MinGW triplet.
set "MSYSTEM=MINGW64"
set "MINGW_PREFIX=/mingw64"

if "%VERBOSE%"=="1" (
    "%BASH%" -lc "set -o pipefail; cd '%REPO_ROOT_WIN%' && repo=$(pwd) && git_sha=$(git rev-parse HEAD) && git_branch=$(git symbolic-ref --quiet --short HEAD || printf detached) && git_dirty=false && if git status --porcelain --untracked-files=all | grep -q .; then git_dirty=true; fi && export MSYSTEM=MINGW64 && export MINGW_PREFIX=/mingw64 && export PATH='/mingw64/bin:/usr/bin:/c/Program Files/Python312:/c/Program Files/Python312/Scripts:'$repo'/build/release-mingw-shipping-x86_64/vcpkg_installed/x64-mingw-static-release/tools/Qt6/bin:'$repo'/build/release-mingw-shipping-x86_64/vcpkg_installed/x64-mingw-static-release/bin':$PATH && /mingw64/bin/cmake.exe --preset %PRESET% -DCMAKE_BUILD_TYPE=Release -DENABLE_LTO_RELEASE=OFF -DMELONPRIME_ENABLE_DEVELOPER_FEATURES=OFF -DMELONPRIME_ENABLE_RENDERER_PERF_TELEMETRY=OFF -DMELONPRIME_ENABLE_VULKAN_LATENCY_CAPTURE=OFF -DMELONPRIME_ENABLE_VULKAN=ON -DMELONPRIME_FORCE_DISABLE_VULKAN=OFF -DMELONPRIME_ENABLE_DX12=ON -DMELONDS_GIT_HASH=$git_sha -DMELONDS_GIT_BRANCH=$git_branch -DMELONDS_GIT_DIRTY=$git_dirty -DMELONDS_BUILD_PROVIDER=shipping-local -U pkgcfg_lib_Faad_m -U pkgcfg_lib_SDL2_m && /mingw64/bin/cmake.exe --build --preset=%PRESET% --parallel %JOBS% --verbose"
) else (
    "%BASH%" -lc "set -o pipefail; cd '%REPO_ROOT_WIN%' && repo=$(pwd) && git_sha=$(git rev-parse HEAD) && git_branch=$(git symbolic-ref --quiet --short HEAD || printf detached) && git_dirty=false && if git status --porcelain --untracked-files=all | grep -q .; then git_dirty=true; fi && export MSYSTEM=MINGW64 && export MINGW_PREFIX=/mingw64 && export PATH='/mingw64/bin:/usr/bin:/c/Program Files/Python312:/c/Program Files/Python312/Scripts:'$repo'/build/release-mingw-shipping-x86_64/vcpkg_installed/x64-mingw-static-release/tools/Qt6/bin:'$repo'/build/release-mingw-shipping-x86_64/vcpkg_installed/x64-mingw-static-release/bin':$PATH && /mingw64/bin/cmake.exe --preset %PRESET% -DCMAKE_BUILD_TYPE=Release -DENABLE_LTO_RELEASE=OFF -DMELONPRIME_ENABLE_DEVELOPER_FEATURES=OFF -DMELONPRIME_ENABLE_RENDERER_PERF_TELEMETRY=OFF -DMELONPRIME_ENABLE_VULKAN_LATENCY_CAPTURE=OFF -DMELONPRIME_ENABLE_VULKAN=ON -DMELONPRIME_FORCE_DISABLE_VULKAN=OFF -DMELONPRIME_ENABLE_DX12=ON -DMELONDS_GIT_HASH=$git_sha -DMELONDS_GIT_BRANCH=$git_branch -DMELONDS_GIT_DIRTY=$git_dirty -DMELONDS_BUILD_PROVIDER=shipping-local -U pkgcfg_lib_Faad_m -U pkgcfg_lib_SDL2_m && LOG=%LOG_FILE% && stdbuf -oL -eL /mingw64/bin/cmake.exe --build --preset=%PRESET% --parallel %JOBS% 2>&1 | tee $LOG; STATUS=${PIPESTATUS[0]}; echo; echo '[melonprime-release] Last '%TAIL_LINES%' log lines (full log: '$LOG'):'; tail -n %TAIL_LINES% $LOG; exit $STATUS"
)

set "RESULT=%ERRORLEVEL%"
if not "%RESULT%"=="0" (
    echo [melonprime-release] Build failed with exit code %RESULT%.
) else (
    echo [melonprime-release] Build succeeded.
    echo [melonprime-release] This binary is the shipping profile: developer features,
    echo [melonprime-release] renderer telemetry, and Vulkan latency capture are OFF.
)
exit /b %RESULT%
