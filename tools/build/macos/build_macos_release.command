#!/usr/bin/env bash
# Double-click in Finder (macOS) or run from Terminal.
#
# Shipping/distribution build of melonPrimeDS, with both the native Metal
# renderer and the Vulkan (MoltenVK) renderer compiled in.
#
# Unlike build_macos_metal_n_vulkan.command, this profile compiles out every
# developer-only and measurement-only feature:
#
#   MELONPRIME_ENABLE_DEVELOPER_FEATURES      OFF
#   MELONPRIME_ENABLE_INPUT_DEBUG_TELEMETRY    OFF
#   MELONPRIME_ENABLE_RENDERER_PERF_TELEMETRY OFF
#   MELONPRIME_ENABLE_GPU_MEMORY_TELEMETRY    OFF
#   MELONPRIME_ENABLE_VULKAN_LATENCY_CAPTURE  OFF
#
# Those gates are re-applied on every configure, so a stale CMake cache cannot
# silently turn this into a developer build. Developer builds are also much
# slower in places that ship fine: the capture-provenance logging in
# Renderer::MarkCaptureCpuCoherent() hashes a 32 KiB VRAM block per emulated
# VRAM write, which VRAM-heavy scenes feel directly.
#
# It builds into its own tree so Qt AUTOGENERATED files from the developer
# profile cannot leak into a shipping bundle. Homebrew Vulkan dependencies are
# installed automatically if missing.
#
# Output: build-mac-release/melonPrimeDS.app
#
# Extra options are forwarded to build-macos-vulkan.sh next to this file
# (--jobs N, --build-only, --no-bundle, --open, --help).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

exec "$SCRIPT_DIR/build-macos-vulkan.sh" \
    --install-deps \
    --with-metal \
    --release \
    --build-dir build-mac-release \
    "$@"
