 }
 
+void SoftRenderer::VBlank()
+{
+#if defined(MELONPRIME_ENABLE_DEVELOPER_FEATURES)
+    DumpSoftwareFrame(Framebuffer[BackBuffer][0], Framebuffer[BackBuffer][1]);
+#endif
+}
